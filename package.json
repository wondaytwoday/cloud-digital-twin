{
  "name": "cloud-atlas-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "collect": "tsx server/collect.ts",
    "check": "tsx server/collect.ts --check",
    "backup": "tsx server/backup-cli.ts backup",
    "restore": "tsx server/backup-cli.ts restore",
    "live": "npm run build && NODE_ENV=production DATA_MODE=live ATLAS_COLLECTOR=1 tsx server/index.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "^3.1163.0",
    "@aws-sdk/client-cost-explorer": "^3.1161.0",
    "@aws-sdk/client-direct-connect": "^3.1161.0",
    "@aws-sdk/client-ec2": "^3.1151.0",
    "@aws-sdk/client-eks": "^3.1161.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1161.0",
    "@aws-sdk/client-iam": "^3.1161.0",
    "@aws-sdk/client-organizations": "^3.1161.0",
    "@aws-sdk/client-rds": "^3.1161.0",
    "@aws-sdk/client-resource-explorer-2": "^3.1161.0",
    "@aws-sdk/client-sts": "^3.1151.0",
    "@azure/identity": "^4.14.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.0.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
