# Copy to .env and fill in only what you use. This file is read by `npm run live`, `npm run collect`, and `npm run check`.
# It is ignored by git. Do not put these values in Vercel: the Vercel deployment cannot collect.

# Azure service principal. All three are needed. Leave empty to use `az login` instead.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# AWS. Use one of: a profile, or an access key. Leave empty to use the default profile.
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=ap-northeast-2
# Read role in each account. Without it, only the signed-in account is collected.
# ATLAS_AWS_ACCOUNT_CONCURRENCY=3
# ATLAS_AWS_REGION_CONCURRENCY=4
# ATLAS_AWS_ROLE_NAME=AtlasReader
# ATLAS_AWS_ACCOUNTS=name=111111111111,name=222222222222

# Google Cloud. Path to a credentials file. Leave empty to use `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=
# ATLAS_GCP_BILLING_TABLE=project.dataset.table

# Optional
# PORT=4317
# ATLAS_COLLECT_MINUTES=60
# ATLAS_COST_HOURS=24
# ATLAS_COLLECT_TIMEOUT_MIN=15
# Corporate networks that only reach the internet through a proxy. Sign-in and the API calls both use it.
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
# Cost currency. AWS Cost Explorer always returns USD; Azure and GCP return the billing account's currency.
# Without rates, each currency is totalled on its own. With rates, everything is converted to ATLAS_COST_CURRENCY and added up.
# ATLAS_COST_CURRENCY=KRW
# ATLAS_FX_RATES=USD=1380
